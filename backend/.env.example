# Backend env. Secrets stay server-side; never commit real keypairs or API keys.
NODE_ENV=development
PORT=8787
MONGODB_URI=mongodb://127.0.0.1:27017/forge_coinflip
CORS_ORIGINS=http://localhost:5173

# Solana / program config. Must all point to the same cluster.
RPC_URL=https://api.devnet.solana.com
PROGRAM_ID=9pJDqDv13FwjWHWJDMB947nV2dH2JbYtdqWBN7kgvzEH
TOKEN_MINT=REPLACE_WITH_BABY_KENJI_MINT
BABY_KENJI_MINT=REPLACE_WITH_BABY_KENJI_MINT
SWITCHBOARD_PROGRAM_ID=REPLACE_WITH_SWITCHBOARD_PROGRAM_ID
SWITCHBOARD_QUEUE=REPLACE_WITH_SWITCHBOARD_QUEUE

# Hot backend key. Fund with limited SOL for transaction fees only.
SETTLE_AUTHORITY_KEYPAIR_PATH=./keys/settle-authority.json

# Optional RPC provider conventions; current code reads RPC_URL directly.
HELIUS_RPC_URL=REPLACE_WITH_HELIUS_RPC_URL
HELIUS_API_KEY=REPLACE_WITH_HELIUS_API_KEY

# Admin/API security. Do not expose admin routes unless bearer auth is enforced.
ADMIN_API_TOKEN=REPLACE_WITH_ADMIN_API_TOKEN

# Economics. Must match on-chain config.
TOTAL_FEE_BPS=1000
SOL_PLAYER_WIN_PAYOUT_BPS=17800
TOKEN_PLAYER_WIN_PAYOUT_BPS=17800

# Intended fee recipients. Current on-chain settlement does not transfer to these yet.
SOL_TEAM_WALLET=REPLACE_WITH_TEAM_SOL_WALLET
SOL_DEV_BUYBACK_WALLET=REPLACE_WITH_DEV_BUYBACK_SOL_WALLET
SOL_HOLDER_REWARDS_WALLET=REPLACE_WITH_HOLDER_REWARDS_SOL_WALLET
TOKEN_TEAM_FEE_ACCOUNT=REPLACE_WITH_TOKEN_TEAM_FEE_ACCOUNT
TOKEN_DEV_FEE_ACCOUNT=REPLACE_WITH_TOKEN_DEV_FEE_ACCOUNT
TOKEN_HOLDER_REWARDS_ACCOUNT=REPLACE_WITH_TOKEN_HOLDER_REWARDS_ACCOUNT

# Holder rewards primitives. Distribution sender/scanner is not production-complete.
HOLDER_REWARDS_DISTRIBUTION_ENABLED=false
HOLDER_REWARDS_AUTHORITY_KEYPAIR_PATH=./keys/rewards-authority.json
HOLDER_REWARDS_SOL_WALLET=REPLACE_WITH_HOLDER_REWARDS_SOL_WALLET
HOLDER_REWARDS_TOKEN_ACCOUNT=REPLACE_WITH_TOKEN_HOLDER_REWARDS_ACCOUNT
HOLDER_REWARDS_MIN_DISTRIBUTION_LAMPORTS=1000000
HOLDER_REWARDS_MIN_DISTRIBUTION_TOKENS=1
HOLDER_REWARDS_EXCLUDED_WALLETS=REPLACE_WITH_ADMIN_WALLET,REPLACE_WITH_TOKEN_TREASURY_VAULT
HOLDER_REWARDS_BATCH_SIZE=50
HOLDER_REWARDS_INTERVAL_MS=3600000
