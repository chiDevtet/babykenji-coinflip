{
  "name": "forge-coinflip-backend",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test -r ts-node/register tests/rewards.test.ts",
    "monte-carlo": "node -r ts-node/register src/sim/monteCarlo.ts",
    "monte-carlo:sol": "npm run monte-carlo -- --asset sol",
    "monte-carlo:token": "npm run monte-carlo -- --asset token",
    "monte-carlo:mixed": "npm run monte-carlo -- --asset mixed",
    "monte-carlo:stress": "npm run monte-carlo -- --scenario mixed-asset-chaos --iterations 100000",
    "test:monte-carlo": "node --test -r ts-node/register src/sim/monteCarlo.test.ts",
    "verify:env": "ts-node ../scripts/verify-env.ts",
    "verify:config": "ts-node ../scripts/verify-config.ts",
    "print:wallet-matrix": "ts-node ../scripts/print-wallet-matrix.ts"
  },
  "dependencies": {
    "@solana/spl-token": "^0.4.9",
    "@solana/web3.js": "^1.95.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "mongoose": "^8.6.0",
    "@switchboard-xyz/on-demand": "^3.10.3",
    "@switchboard-xyz/common": "^5.8.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.0"
  }
}
