# Vite env is public. Never put private keys, Mongo URLs, or admin tokens here.
VITE_NETWORK=devnet
VITE_RPC_URL=https://api.devnet.solana.com
VITE_BACKEND_URL=http://localhost:8787
VITE_PROGRAM_ID=REPLACE_WITH_PROGRAM_ID
VITE_TOKEN_MINT=REPLACE_WITH_BABY_KENJI_MINT
VITE_BABY_KENJI_MINT=REPLACE_WITH_BABY_KENJI_MINT
VITE_SWITCHBOARD_PROGRAM_ID=REPLACE_WITH_SWITCHBOARD_PROGRAM_ID
VITE_SWITCHBOARD_QUEUE=REPLACE_WITH_SWITCHBOARD_QUEUE

# Display/reference only. On-chain GameConfig is authoritative.
VITE_TOTAL_FEE_BPS=1000
VITE_SOL_PLAYER_WIN_PAYOUT_BPS=17800
VITE_TOKEN_PLAYER_WIN_PAYOUT_BPS=17800
